import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

const loader = new GLTFLoader();

let car;

loader.load(
    "/models/car.glb",
    (gltf) => {

        car = gltf.scene;

        car.scale.set(1.5,1.5,1.5);

        car.position.set(0,0,0);

        scene.add(car);

    }
);
