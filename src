*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#101010;
    font-family:Arial, Helvetica, sans-serif;
    touch-action:none;
}

canvas{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    display:block;
}

#loading{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    color:white;
    font-size:30px;
    font-weight:bold;
    z-index:100;
}

#hud{
    position:absolute;
    top:20px;
    left:20px;
    color:white;
    z-index:50;
    user-select:none;
}

#speed{
    font-size:42px;
    font-weight:bold;
    margin-bottom:10px;
}

#score{
    font-size:22px;
    margin-bottom:20px;
}

#boost{
    width:240px;
    height:20px;
    border:2px solid white;
    border-radius:10px;
    overflow:hidden;
    background:#333;
}

#boostBar{
    width:0%;
    height:100%;
    background:linear-gradient(90deg,#00c8ff,#008cff);
    transition:width .1s linear;
}
